# --- HTTP ---
PAYMENT_BE=:3005

# --- Database (DATABASE_PROVIDER driven) ---
# sqlite (default) — no extra credentials. Path via DATABASE_PATH.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=data/payment.db
# MySQL / Postgres / SQL Server — uncomment & fill when switching provider
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=secret
# DATABASE_NAME=payment

# Run GORM AutoMigrate only when true (safe default: false)
DATABASE_MIGRATE=true

# --- Secrets ---
PAYMENT_JWT_SECRET=
PAYMENT_ENC_KEY=